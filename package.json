{
  "name": "api-palpitei",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "start": "node --env-file=.env dist/src/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "buildW": "rm -rf dist && tsc --extendedDiagnostics",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "npx drizzle-kit push",
    "db:drop": "npx drizzle-kit drop",
    "db:deletemigrations": "rm -rf src/db/migrations/*",
    "prepare": "husky"
  },
  "keywords": [],
  "author": {
    "name": "Higor Silva",
    "url": "https://github.com/hiigorsilva"
  },
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.20.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@scalar/fastify-api-reference": "^1.55.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "git-commit-msg-linter": "^5.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.17.1"
  }
}
